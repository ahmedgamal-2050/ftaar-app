# Copy this file to .env and adjust for your environment.
# Vars must be prefixed with EXPO_PUBLIC_ to be inlined into the JS bundle
# (see https://docs.expo.dev/guides/environment-variables/).

# Base URL of the Ftaar backend API (apps/backend). Includes the /api prefix.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# WebSocket URL for the NestJS gateway. Only used from Phase 8 onward.
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
