generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LobbyStatus {
  open
  locked
  billed
  settled
  cancelled

  @@map("lobby_status")
}

enum MemberRole {
  admin
  member

  @@map("member_role")
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed

  @@map("payment_status")
}

model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind         String         @db.VarChar(32)
  email        String?        @db.VarChar(255)
  deviceId     String?        @map("device_id") @db.VarChar(255)
  passwordHash String?        @map("password_hash") @db.VarChar(255)
  displayName  String         @map("display_name") @db.VarChar(120)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  LobbyMember[]

  @@map("users")
}

model Restaurant {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique @db.VarChar(255)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  menuItems MenuItem[]
  lobbies   Lobby[]

  @@map("restaurants")
}

model MenuItem {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String      @db.VarChar(255)
  referencePrice  BigInt      @map("reference_price")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems      OrderItem[]

  @@unique([id, restaurantId], map: "uq_menu_items_id_restaurant")
  @@index([restaurantId], map: "idx_menu_items_restaurant_id")
  @@map("menu_items")
}

model Lobby {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  code         String        @unique(map: "uq_lobbies_code") @db.VarChar(32)
  status       LobbyStatus
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  members      LobbyMember[]
  orderItems   OrderItem[]
  bill         LobbyBill?

  @@unique([id, restaurantId], map: "uq_lobbies_id_restaurant")
  @@index([restaurantId], map: "idx_lobbies_restaurant_id")
  @@index([status], map: "idx_lobbies_status")
  @@map("lobbies")
}

model LobbyMember {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lobbyId     String      @map("lobby_id") @db.Uuid
  lobby       Lobby       @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id])
  role        MemberRole
  displayName String      @map("display_name") @db.VarChar(120)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  orderItems  OrderItem[]

  @@index([lobbyId], map: "idx_lobby_members_lobby_id")
  @@map("lobby_members")
}

model OrderItem {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lobbyId       String      @map("lobby_id") @db.Uuid
  lobby         Lobby       @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  lobbyMemberId String      @map("lobby_member_id") @db.Uuid
  lobbyMember   LobbyMember @relation(fields: [lobbyMemberId], references: [id])
  menuItemId    String      @map("menu_item_id") @db.Uuid
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id])
  restaurantId  String      @map("restaurant_id") @db.Uuid
  qty           Int
  actualPrice   BigInt      @map("actual_price")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([lobbyId], map: "idx_order_items_lobby_id")
  @@index([menuItemId], map: "idx_order_items_menu_item_id")
  @@map("order_items")
}

model LobbyBill {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lobbyId       String        @unique @map("lobby_id") @db.Uuid
  lobby         Lobby         @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  subtotal      BigInt
  tax           BigInt
  total         BigInt
  paymentStatus PaymentStatus @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lobbyId], map: "idx_lobby_bill_lobby_id")
  @@map("lobby_bill")
}
