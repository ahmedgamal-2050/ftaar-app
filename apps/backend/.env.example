NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Runtime connection used by NestJS.
# Local:  postgres://<user>:<password>@127.0.0.1:5432/<dbname>
# Neon:   use the pooled connection string  (pooler.neon.tech)
DATABASE_URL=postgres://ftaar:ftaar@127.0.0.1:5432/ftaar

# Direct (non-pooled) connection used by Prisma CLI only (migrate, generate, introspect).
# Local:  same value as DATABASE_URL
# Neon:   use the direct (non-pooled) connection string  (db.neon.tech)
DIRECT_URL=postgres://ftaar:ftaar@127.0.0.1:5432/ftaar

JWT_SECRET=change-this-to-a-random-32-char-secret-in-production

# Comma-separated browser origins. Include the Angular dev server if you skip the proxy.
# CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ── OTP / Email verification ─────────────────────────────────────────────────
# REQUIRED: secret key for HMAC-SHA256 OTP hashing (min 32 chars)
EMAIL_OTP_SECRET=change-this-to-a-random-secret-in-production

# OTP and token TTL / limits (these defaults are applied automatically if not set)
# EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
# EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5
# EMAIL_VERIFICATION_OTP_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_OTP_TTL_MINUTES=10
# PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
# PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_TOKEN_TTL_MINUTES=10

# ── SMTP (Mailtrap for local dev / staging) ──────────────────────────────────
# Get these from https://mailtrap.io → Email Testing → SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@ftaar.app
